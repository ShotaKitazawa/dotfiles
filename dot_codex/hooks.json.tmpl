{
  "description": "Run user-level Codex lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/codex/hooks/session-start",
            "statusMessage": "Running session-start hooks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.codex/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
