#!/usr/bin/env python3
"""Attempt OAuth login for every HTTP MCP server in ~/.mcp.json.

Which servers exist is intentionally not this script's concern: it just reads
whatever `mcpServers` entries have a `url` (i.e. are HTTP, not stdio) from
~/.mcp.json and logs in to each. That file may be managed by a private/second
chezmoi source; this script only needs it to already be on disk.

Login is deliberately best-effort: an unavailable server, a missing
~/.mcp.json, or an MCP server without Codex OAuth support must not prevent
starting Codex. Logins run in parallel since each is an independent, slow
(browser-driven) OAuth flow.

A successful login for a server is cached in CACHE_PATH and skipped on the
next session start until TOKEN_TTL_SECONDS has passed, so back-to-back
session starts don't pop open a browser tab again. TOKEN_TTL_SECONDS (2h) is
a fixed, deliberately conservative value -- well under the ~12h expires_in
Codex's own OAuth token response was observed to use for one of these
servers -- rather than the real per-token expiry.
Reading the real expiry would require decrypting Codex's OAuth credential
out of the macOS Keychain (the only place it's stored; `codex mcp login`
doesn't surface it any other way), which adds real complexity and
uncertainty (undocumented, version-dependent storage format; unclear
whether an unattended read triggers its own Keychain access prompt) for
little benefit over a short fixed TTL. Only a successful login is cached --
a failed/skipped login is retried on every subsequent session start.

On macOS, the "Authentication complete. You may close this window." tab that
each login leaves behind in Chrome is closed automatically (best-effort, via
JavaScript for Automation) after all login flows finish. This requires one-time
Automation permission for whatever app runs this script to control Google
Chrome (macOS will prompt for it on first run).
"""
import json
import os
import platform
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

CODEX_BIN = os.environ.get("CODEX_BIN", "codex")
MCP_JSON_PATH = Path(os.environ.get("MCP_JSON_PATH", Path.home() / ".mcp.json"))
CACHE_PATH = Path(
    os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")
) / "codex" / "login-mcps-cache.json"
TOKEN_TTL_SECONDS = 2 * 60 * 60

# Codex's MCP OAuth callback server redirects the browser to a loopback URL
# with the shape http://localhost:<port>/callback/<id> (some versions may use
# 127.0.0.1 instead). Wait until Chrome reports that callback page as fully
# loaded before closing it; arriving at the callback URL alone does not mean
# that authentication has completed. Requiring the OAuth code/state query
# avoids sweeping up ordinary localhost development tabs.
_CLOSE_OAUTH_CALLBACK_TABS_JXA = '''
function isOAuthCallback(url) {
    const isLoopback = url.startsWith("http://localhost:") ||
        url.startsWith("http://127.0.0.1:");
    return isLoopback && url.includes("/callback/") &&
        url.includes("code=") && url.includes("state=");
}

function closeOAuthCallbackTabs(chrome) {
    let closedCount = 0;
    for (const window of chrome.windows()) {
        const tabs = window.tabs();
        for (let i = tabs.length - 1; i >= 0; i--) {
            const tab = tabs[i];
            if (isOAuthCallback(tab.url()) && !tab.loading()) {
                tab.close();
                closedCount++;
            }
        }
    }
    return closedCount;
}

const chrome = Application("Google Chrome");
let closedCount = 0;
if (chrome.running()) {
    closedCount = closeOAuthCallbackTabs(chrome);
}
closedCount;
'''


def close_oauth_callback_tabs() -> None:
    if platform.system() != "Darwin":
        return

    try:
        # codex exits successfully only after handling the OAuth callback. Give
        # Chrome a moment to finish painting the completion response, then
        # inspect all tabs once; this must not add a per-login polling delay.
        time.sleep(0.5)
        result = subprocess.run(
            ["osascript", "-l", "JavaScript", "-e", _CLOSE_OAUTH_CALLBACK_TABS_JXA],
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"Failed to close MCP OAuth callback tabs: {exc}", file=sys.stderr)
        return

    if result.returncode != 0:
        detail = result.stderr.strip() or f"osascript exited with status {result.returncode}"
        print(f"Failed to close MCP OAuth callback tabs: {detail}", file=sys.stderr)
    else:
        print(f"Closed MCP OAuth callback tabs: {result.stdout.strip() or '0'}", file=sys.stderr)


def http_mcp_server_names() -> list[str]:
    try:
        document = json.loads(MCP_JSON_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []

    servers = document.get("mcpServers", {})
    if not isinstance(servers, dict):
        return []

    return [
        name
        for name, server in servers.items()
        if isinstance(server, dict) and isinstance(server.get("url"), str)
    ]


def load_cache() -> dict[str, float]:
    try:
        raw = json.loads(CACHE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(raw, dict):
        return {}
    return {name: ts for name, ts in raw.items() if isinstance(name, str) and isinstance(ts, (int, float))}


def save_cache(cache: dict[str, float]) -> None:
    CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
    CACHE_PATH.write_text(json.dumps(cache), encoding="utf-8")


def login(mcp_server: str) -> tuple[str, bool, str]:
    try:
        result = subprocess.run(
            [CODEX_BIN, "mcp", "login", mcp_server],
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        return mcp_server, False, str(exc)

    output = (result.stdout + result.stderr).strip()
    return mcp_server, result.returncode == 0, output


def main() -> int:
    mcp_servers = http_mcp_server_names()
    if not mcp_servers:
        return 0

    cache = load_cache()
    cache = {name: ts for name, ts in cache.items() if name in mcp_servers}  # drop removed servers
    now = time.time()

    to_login = []
    for name in mcp_servers:
        last_success = cache.get(name)
        if last_success is not None and now - last_success < TOKEN_TTL_SECONDS:
            print(f"MCP login skipped (cached login within TTL): {name}", file=sys.stderr)
        else:
            to_login.append(name)

    if not to_login:
        return 0

    print(f"Logging in to MCP servers: {', '.join(to_login)}", file=sys.stderr)

    any_login_succeeded = False
    with ThreadPoolExecutor(max_workers=len(to_login)) as pool:
        futures = {pool.submit(login, mcp_server): mcp_server for mcp_server in to_login}
        for future in as_completed(futures):
            mcp_server, ok, output = future.result()
            if output:
                print(output, file=sys.stderr)
            if ok:
                print(f"MCP login succeeded: {mcp_server}", file=sys.stderr)
                cache[mcp_server] = now
                any_login_succeeded = True
            else:
                print(f"MCP login skipped or failed: {mcp_server}", file=sys.stderr)

    if any_login_succeeded:
        close_oauth_callback_tabs()

    save_cache(cache)
    return 0


if __name__ == "__main__":
    sys.exit(main())
