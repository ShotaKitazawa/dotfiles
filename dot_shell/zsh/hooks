#!/usr/bin/env zsh

###########################################################
# starship
if [ -f $HOME/.config/starship-work.toml ]; then
  _starship_config=$HOME/.cache/starship.toml
  if [[ ! -s $_starship_config || $HOME/.config/starship.toml -nt $_starship_config || $HOME/.config/starship-work.toml -nt $_starship_config ]]; then
    mkdir -p $HOME/.cache
    cat $HOME/.config/starship.toml $HOME/.config/starship-work.toml >| $_starship_config
  fi
  export STARSHIP_CONFIG=$HOME/.cache/starship.toml
  unset _starship_config
fi
(( $+commands[starship] )) && eval "$(starship init zsh)"

###########################################################
# mise
[ -f $HOME/.local/bin/mise ] && eval "$($HOME/.local/bin/mise activate zsh)"
