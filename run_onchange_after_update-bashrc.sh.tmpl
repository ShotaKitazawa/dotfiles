#!/usr/bin/env bash
set -euo pipefail

# Keep the helper's contents in the rendered script so run_onchange is also
# invalidated when the helper changes.
# update-shell-rc.sh sha256: {{ include ".scripts/update-shell-rc.sh" | sha256sum }}
# Base64 keeps arbitrary managed text from being interpreted as shell syntax or
# prematurely terminating a fixed heredoc delimiter.
printf '%s' '{{ .bashrcManagedBlock | b64enc }}' | base64 --decode | \
  "{{ .chezmoi.sourceDir }}/.scripts/update-shell-rc.sh" "{{ .chezmoi.homeDir }}/.bashrc"
